# PostNode environment variables
# Copy this file to .env and fill it in. Never commit .env.
# Lines that start with "# NAME=" are optional: remove the "# " to use them.
# Switches marked (on/off) turn ON with ANY value, even "false".
# To keep one off, leave its line commented out.

# ======================================================================
# Docker (read by docker-compose.yaml and docker-compose.dev.yaml)
# Use letters and numbers only in passwords; they go inside DATABASE_URL.
# ======================================================================
# App database user
POSTGRES_USER=""
# App database password
POSTGRES_PASSWORD=""
# App database name
POSTGRES_DB=""
# Password of Temporal's own database
TEMPORAL_DB_PASSWORD=""
# pgAdmin login email (docker-compose.dev.yaml only)
PGADMIN_EMAIL=""
# pgAdmin login password (docker-compose.dev.yaml only)
PGADMIN_PASSWORD=""
# Public URL when running with docker-compose.yaml; empty means http://localhost:4007
POSTNODE_URL=""

# ======================================================================
# Core
# ======================================================================
# Long random string that signs logins (required)
JWT_SECRET=""
# URL of the web app, no trailing slash
FRONTEND_URL="http://localhost:4200"
# Extra allowed origin for the API; use the same value as FRONTEND_URL
MAIN_URL="http://localhost:4200"
# URL of the API as seen from the browser
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
# URL of the API as seen from the frontend server
BACKEND_INTERNAL_URL="http://localhost:3000"
# UI mode the app needs; keep "true"
IS_GENERAL="true"
# Turns off the usage reporting of Next.js
NEXT_TELEMETRY_DISABLED=1
# Turns off the usage reporting of the Prisma CLI
CHECKPOINT_DISABLE=1
# Turns off the usage reporting of CopilotKit (the AI assistant library)
COPILOTKIT_TELEMETRY_DISABLED=true
# Product name (default PostNode); set both to the same value
# APP_NAME=""
# NEXT_PUBLIC_APP_NAME=""
# Block new sign-ups (exact value "true")
# DISABLE_REGISTRATION="true"
# (on/off) Plain-http cookie mode; only if login does not stay signed in over http (Safari, LAN IP). Weakens security.
# NOT_SECURED="true"

# ======================================================================
# Database
# ======================================================================
# PostgreSQL connection; from source use the POSTGRES_* values above with localhost
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# ======================================================================
# Redis
# ======================================================================
# Redis connection
REDIS_URL="redis://localhost:6379"
# Port docker-compose.dev.yaml publishes Redis on (default 6379); change both if 6379 is taken
# REDIS_PORT=6379

# ======================================================================
# Temporal (background publishing)
# ======================================================================
# Temporal server address (default localhost:7233)
# TEMPORAL_ADDRESS="localhost:7233"

# ======================================================================
# Storage
# ======================================================================
# "local" (files on this machine) or "cloudflare" (Cloudflare R2)
STORAGE_PROVIDER="local"
# Absolute folder for uploaded media when local, e.g. D:/PostNode-uploads (required for local)
UPLOAD_DIRECTORY=""
# Cloudflare R2 account id (only for STORAGE_PROVIDER="cloudflare")
# CLOUDFLARE_ACCOUNT_ID=""
# Cloudflare R2 access key
# CLOUDFLARE_ACCESS_KEY=""
# Cloudflare R2 secret key
# CLOUDFLARE_SECRET_ACCESS_KEY=""
# Cloudflare R2 bucket name
# CLOUDFLARE_BUCKETNAME=""
# Public URL of the bucket
# CLOUDFLARE_BUCKET_URL=""
# Bucket region
# CLOUDFLARE_REGION="auto"

# ======================================================================
# Email (optional; without it new accounts are activated automatically)
# ======================================================================
# "resend", "ses" or "nodemailer"
# EMAIL_PROVIDER=""
# Sender address
# EMAIL_FROM_ADDRESS=""
# Sender name
# EMAIL_FROM_NAME=""
# Resend API key
# RESEND_API_KEY=""
# SMTP host (nodemailer)
# EMAIL_HOST=""
# SMTP port (nodemailer)
# EMAIL_PORT=""
# Use TLS, exact value "true" (nodemailer)
# EMAIL_SECURE="true"
# SMTP user (nodemailer)
# EMAIL_USER=""
# SMTP password (nodemailer)
# EMAIL_PASS=""
# Amazon SES region
# SES_REGION=""
# Amazon SES access key
# SES_ACCESS_KEY=""
# Amazon SES secret key
# SES_SECRET_ACCESS_KEY=""

# ======================================================================
# Encryption of channel tokens in the database (optional, recommended on a server)
# ======================================================================
# "local" or "aws-kms"; without it tokens are stored unencrypted
# ENCRYPTION_PROVIDER="local"
# Key for "local": create one with `openssl rand -base64 32`. Keep it safe.
# ENCRYPTION_KEY=""

# ======================================================================
# Login providers (optional)
# ======================================================================
# Google login uses the YouTube credentials below
# GitHub OAuth app client id
# GITHUB_CLIENT_ID=""
# GitHub OAuth app secret
# GITHUB_CLIENT_SECRET=""
# Sign in with Apple: Services ID
# APPLE_CLIENT_ID=""
# Sign in with Apple: team id
# APPLE_TEAM_ID=""
# Sign in with Apple: key id
# APPLE_KEY_ID=""
# Sign in with Apple: .p8 private key with \n for new lines
# APPLE_PRIVATE_KEY=""
# (on/off) Show a login button for your own OpenID Connect server (Authentik, Keycloak...)
# POSTIZ_GENERIC_OAUTH="true"
# OpenID Connect authorize URL
# POSTIZ_OAUTH_AUTH_URL=""
# OpenID Connect token URL
# POSTIZ_OAUTH_TOKEN_URL=""
# OpenID Connect userinfo URL
# POSTIZ_OAUTH_USERINFO_URL=""
# OpenID Connect client id
# POSTIZ_OAUTH_CLIENT_ID=""
# OpenID Connect client secret
# POSTIZ_OAUTH_CLIENT_SECRET=""
# Label of the OpenID Connect button
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=""
# Logo URL of the OpenID Connect button
# NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=""

# ======================================================================
# Social platforms: fill in only the ones you use.
# Bluesky, Lemmy, Nostr, WordPress, Medium, Dev.to, Hashnode and Listmonk
# need no keys here; you enter their details in the app.
# ======================================================================

# --- X (developer.x.com) ---
# X app API key
X_API_KEY=""
# X app API secret
X_API_SECRET=""

# --- LinkedIn (linkedin.com/developers), profiles and pages ---
# LinkedIn app client id
LINKEDIN_CLIENT_ID=""
# LinkedIn app client secret
LINKEDIN_CLIENT_SECRET=""

# --- Facebook and Instagram via Facebook (developers.facebook.com) ---
# Meta app id
FACEBOOK_APP_ID=""
# Meta app secret
FACEBOOK_APP_SECRET=""

# --- Instagram without Facebook (developers.facebook.com) ---
# Instagram app id
INSTAGRAM_APP_ID=""
# Instagram app secret
INSTAGRAM_APP_SECRET=""

# --- Threads (developers.facebook.com) ---
# Threads app id
THREADS_APP_ID=""
# Threads app secret
THREADS_APP_SECRET=""

# --- YouTube and Google login (console.cloud.google.com) ---
# Google OAuth client id
YOUTUBE_CLIENT_ID=""
# Google OAuth client secret
YOUTUBE_CLIENT_SECRET=""
# Separate client id for Google Business Profile (default: the YouTube one)
# GOOGLE_GMB_CLIENT_ID=""
# Separate client secret for Google Business Profile (default: the YouTube one)
# GOOGLE_GMB_CLIENT_SECRET=""

# --- TikTok (developers.tiktok.com) ---
# TikTok app client key
TIKTOK_CLIENT_ID=""
# TikTok app client secret
TIKTOK_CLIENT_SECRET=""
# TikTok Business app client id
TIKTOK_BUSINESS_CLIENT_ID=""
# TikTok Business app client secret
TIKTOK_BUSINESS_CLIENT_SECRET=""

# --- Pinterest (developers.pinterest.com) ---
# Pinterest app id
PINTEREST_CLIENT_ID=""
# Pinterest app secret
PINTEREST_CLIENT_SECRET=""

# --- Reddit (reddit.com/prefs/apps) ---
# Reddit app client id
REDDIT_CLIENT_ID=""
# Reddit app secret
REDDIT_CLIENT_SECRET=""

# --- Discord (discord.com/developers) ---
# Discord app client id
DISCORD_CLIENT_ID=""
# Discord app client secret
DISCORD_CLIENT_SECRET=""
# Discord bot token
DISCORD_BOT_TOKEN_ID=""

# --- Slack (api.slack.com/apps) ---
# Slack app client id
SLACK_ID=""
# Slack app client secret
SLACK_SECRET=""

# --- Telegram (@BotFather) ---
# Telegram bot token
# TELEGRAM_TOKEN=""
# Telegram bot username
# TELEGRAM_BOT_NAME=""

# --- Mastodon ---
# Mastodon server (default https://mastodon.social)
MASTODON_URL=""
# Mastodon app client id
MASTODON_CLIENT_ID=""
# Mastodon app client secret
MASTODON_CLIENT_SECRET=""

# --- Tumblr (tumblr.com/oauth/apps) ---
# Tumblr consumer key
TUMBLR_CLIENT_ID=""
# Tumblr consumer secret
TUMBLR_CLIENT_SECRET=""

# --- Twitch (dev.twitch.tv) ---
# Twitch app client id
TWITCH_CLIENT_ID=""
# Twitch app client secret
TWITCH_CLIENT_SECRET=""

# --- Kick (kick.com developer settings) ---
# Kick app client id
KICK_CLIENT_ID=""
# Kick app client secret
KICK_SECRET=""

# --- VK (id.vk.com) ---
# VK app id
VK_ID=""

# --- Dribbble (dribbble.com/account/applications) ---
# Dribbble app client id
DRIBBBLE_CLIENT_ID=""
# Dribbble app client secret
DRIBBBLE_CLIENT_SECRET=""

# --- Whop (whop.com developer) ---
# Whop app client id
WHOP_CLIENT_ID=""

# --- MeWe ---
# MeWe app id
# MEWE_APP_ID=""
# MeWe API key
# MEWE_API_KEY=""

# --- Farcaster (neynar.com) ---
# Neynar client id (also shows the Farcaster login button)
# NEYNAR_CLIENT_ID=""
# Neynar API key
# NEYNAR_SECRET_KEY=""
# Farcaster id of the account that represents your app
# NEYNAR_APP_FID=""
# Recovery phrase of that account's wallet, used to sign key requests
# NEYNAR_APP_MNEMONIC=""

# ======================================================================
# AI features (optional; each one sends your content to that provider)
# ======================================================================
# OpenAI key for the assistant, post generation and images
# OPENAI_API_KEY=""
# fal.ai key for image and video generation
# FAL_KEY=""
# ElevenLabs key for voice-over videos (the name has a double S)
# ELEVENSLABS_API_KEY=""
# Tavily key for web search in the agent
# TAVILY_API_KEY=""
# Deepgram key for video transcription
# DEEPGRAM_API_KEY=""
# EvoLink key for Seedance video generation
# EVOLINK_API_KEY=""
# Transloadit auth key
# TRANSLOADIT_AUTH=""
# Transloadit secret
# TRANSLOADIT_SECRET=""
# Transloadit template id
# TRANSLOADIT_TEMPLATE=""

# ======================================================================
# Short links (optional; the first one set is used)
# ======================================================================
# Dub API token
# DUB_TOKEN=""
# Dub API URL (default https://api.dub.co)
# DUB_API_ENDPOINT=""
# Dub short link domain (default dub.sh)
# DUB_SHORT_LINK_DOMAIN=""
# Short.io secret key
# SHORT_IO_SECRET_KEY=""
# Kutt API key
# KUTT_API_KEY=""
# Kutt API URL (default https://kutt.it/api/v2)
# KUTT_API_ENDPOINT=""
# Kutt short link domain (default kutt.it)
# KUTT_SHORT_LINK_DOMAIN=""
# LinkDrip API key
# LINK_DRIP_API_KEY=""
# LinkDrip API URL (default https://api.linkdrip.com/v1/)
# LINK_DRIP_API_ENDPOINT=""
# LinkDrip short link domain (default dripl.ink)
# LINK_DRIP_SHORT_LINK_DOMAIN=""

# ======================================================================
# MCP server and public API
# ======================================================================
# Public API requests per hour (default 90)
# API_LIMIT=90
# MCP address shown in Settings > Developers (default: NEXT_PUBLIC_BACKEND_URL)
# MCP_URL=""
# Only these domains may register as MCP OAuth clients, e.g. "claude.ai,claude.com" (empty: anyone)
# DCR_VERIFIED_DOMAINS="claude.ai,claude.com"

# ======================================================================
# Other options
# ======================================================================
# Allow requests to localhost and private addresses (exact value "true").
# Needed to post local media when everything runs on one machine.
# DISABLE_SSRF_PROTECTION="true"
# Comma-separated providers to hide from the add-channel screen, e.g. "tiktok"
# HIDDEN_PROVIDERS=""
# (on/off) Turn off image compression in the browser
# DISABLE_IMAGE_COMPRESSION="true"
# (on/off) Turn off X analytics requests
# DISABLE_X_ANALYTICS="true"
# Polotno design editor key (commercial)
# NEXT_PUBLIC_POLOTNO=""
# Invisible reCAPTCHA on anonymous preview comments (sends data to Google)
# RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""
